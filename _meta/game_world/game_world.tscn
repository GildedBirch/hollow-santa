[sub_resource type="GDScript" id="GDScript_ftbg6"]
script/source = "extends Label


var points: int = 0


func _ready() -> void:
	SignalBus.player.points_gained.connect(func(a: int):
		if points + a < 0:
			get_tree().reload_current_scene.call_deferred()
		points += a
		points = max(0, points)
		text = \"%s\" % points
		)
"

[sub_resource type="GDScript" id="GDScript_rika7"]
script/source = "extends Area2D


@export var win_label: Label


func _ready() -> void:
	body_entered.connect(func(_body: Node2D):
		win_label.show()
		)
"

